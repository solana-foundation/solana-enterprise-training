# Mosaic stablecoin demo - environment configuration
# Copy this file to .env and fill in the values as you progress
# through the scripts (01 -> 06).

# RPC endpoint (defaults to devnet if unset)
RPC_URL=https://api.devnet.solana.com

# Authority keypair as a JSON byte array (64 bytes).
# Export from a Solana CLI keypair file:
#   AUTHORITY_PRIVATE_KEY=$(cat ~/.config/solana/id.json)
AUTHORITY_PRIVATE_KEY=

# Set after running 01-create-stablecoin.ts (printed in its output)
MINT_ADDRESS=

# Wallet that receives minted tokens (02-mint-tokens.ts)
RECIPIENT_ADDRESS=

# Wallet to sanction-freeze (03) and seize from (04)
SANCTIONED_WALLET=

# Treasury / recovery wallet that receives seized tokens (04-force-transfer.ts)
RECOVERY_WALLET=
