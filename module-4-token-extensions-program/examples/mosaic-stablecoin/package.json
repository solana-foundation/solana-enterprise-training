{
  "name": "mosaic-stablecoin-demo",
  "version": "1.0.0",
  "description": "Enterprise stablecoin demo using Solana Mosaic SDK - compliance, access control, and asset seizure",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "create-token": "node --experimental-wasm-modules --import tsx src/01-create-stablecoin.ts",
    "mint-tokens": "node --experimental-wasm-modules --import tsx src/02-mint-tokens.ts",
    "blocklist": "node --experimental-wasm-modules --import tsx src/03-blocklist-address.ts",
    "force-transfer": "node --experimental-wasm-modules --import tsx src/04-force-transfer.ts",
    "pause-token": "node --experimental-wasm-modules --import tsx src/05-pause-token.ts",
    "inspect-token": "node --experimental-wasm-modules --import tsx src/06-inspect-token.ts"
  },
  "dependencies": {
    "@solana/kit": "^6.10.0",
    "@solana-program/system": "^0.12.2",
    "@solana-program/token-2022": "^0.10.0",
    "@solana/mosaic-sdk": "^0.2.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
