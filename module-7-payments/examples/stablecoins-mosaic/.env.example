# Solana RPC endpoint (devnet for testing)
RPC_URL=https://api.devnet.solana.com

# Sender wallet private key (base58 encoded)
# NEVER commit real private keys - this is for local development only
SENDER_PRIVATE_KEY=your_base58_private_key_here

# Stablecoin mint address (Token-2022)
# Replace with your deployed stablecoin mint
MINT_ADDRESS=your_mint_address_here
